{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/gate.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ornek-amber.vercel.app"
        }
      ],
      "destination": "https://ornek-ubt.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ornek-erasylashirbay16-6886.vercel.app"
        }
      ],
      "destination": "https://ornek-ubt.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/specialities/:code",
      "destination": "/specialities-v2.html"
    },
    {
      "source": "/specialities",
      "destination": "/specialities-v2.html"
    }
  ]
}
